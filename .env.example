BOT_TOKEN=your_telegram_bot_token_here

OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional override; check openrouter.ai/models (filter by "free") if this one stops working
OPENROUTER_MODEL=openai/gpt-oss-20b:free

POSTGRES_USER=diary
POSTGRES_PASSWORD=changeme
POSTGRES_DB=diary
POSTGRES_PORT=5433

REDIS_PORT=6379

# Optional overrides
# MEDIA_ROOT=media
# WHISPER_MODEL_SIZE=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16   # use int8 on older GPUs (e.g. GTX 10xx)

# POSTGRES_HOST/REDIS_HOST: only needed when running bot/worker outside Docker
# (default "localhost"). docker-compose.yml sets these to "postgres"/"redis"
# automatically for the bot/worker containers.
# POSTGRES_HOST=localhost
# REDIS_HOST=localhost

# Comma-separated Telegram user IDs allowed to use /grant to top up someone's quota.
# ADMIN_IDS=123456789
# Optional: shown to users in the "quota exceeded" message, e.g. a Telegram @handle.
# ADMIN_CONTACT=@your_admin_handle

